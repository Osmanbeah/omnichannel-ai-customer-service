# Server Configuration
PORT=3000

# Facebook / Meta Messenger & Page Webhook Configuration
# 1. FB_PAGE_ACCESS_TOKEN: Generated from Meta for Developers -> App -> Messenger -> API Setup
# 2. FB_VERIFY_TOKEN: Any secure random string you choose (must match what you enter in Meta Webhooks dashboard)
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
FB_VERIFY_TOKEN=my_secure_messenger_verify_token_123

# Telegram Bot Configuration
# 1. TELEGRAM_BOT_TOKEN: Obtained from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter AI Configuration
# 1. OPENROUTER_API_KEY: Obtained from https://openrouter.ai/keys
# 2. OPENROUTER_MODEL: e.g. "meta-llama/llama-3.1-8b-instruct:free", "meta-llama/llama-3.3-70b-instruct:free", "google/gemini-2.0-flash-exp:free"
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Handoff Configuration (Comma-separated keywords that trigger human handoff)
HANDOFF_KEYWORDS=human,agent,representative,support,talk to someone,help desk,real person,operator,manager
